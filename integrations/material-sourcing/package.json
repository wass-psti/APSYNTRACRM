{
  "name": "material-sourcing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/browser.mjs",
    "test:advanced": "node tests/advanced-browser.mjs",
    "test:backend": "node --experimental-strip-types tests/backend.integration.mjs",
    "test:migrations": "sh scripts/verify-migrations.sh",
    "api": "node --experimental-strip-types server/localApi.ts",
    "test:crud": "sh scripts/test-crud.sh",
    "test:pricing": "MS_PRICING_ONLY=1 sh scripts/test-crud.sh",
    "test:collaboration": "MS_COLLAB_ONLY=1 sh scripts/test-crud.sh",
    "test:bulk": "MS_BULK_ONLY=1 sh scripts/test-crud.sh"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "playwright-core": "1.51.1",
    "read-excel-file": "9.3.20",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  }
}
