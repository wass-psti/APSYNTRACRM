{
  "name": "paseo-de-lomboy-booking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "VITE_RESERVATION_API_BASE_URL='' vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "accept:fe10": "bash scripts/accept-fe10.sh",
    "profile:imm07": "node scripts/profile-imm07.mjs docs/performance/FE-IMM-07-latest.json",
    "accept:imm08": "bash scripts/accept-imm08.sh",
    "accept:guest-cutover": "npm run accept:imm08",
    "test:be01:server": "node --test server/staging.test.mjs",
    "test:be01:browser": "playwright test --config playwright.be01.config.ts",
    "accept:be01": "npm run test:be01:server && npm run test:be01:browser && npm run accept:guest-cutover",
    "dev:staging": "bash scripts/run-staging.sh",
    "dev:supabase": "VITE_RESERVATION_API_BASE_URL=https://jtlusodorfnyzgyuewkz.supabase.co/functions/v1/pdl-guest-api npm run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "test:be02:edge": "node --test supabase/tests/pdl_be02_edge_retry.test.mjs",
    "test:be02:supabase": "playwright test --config playwright.pdl-supabase.config.ts",
    "accept:be02": "npm run test:be02:edge && npm run accept:be01 && npm run test:be02:supabase",
    "test:be02b:config": "playwright test --config playwright.pdl-supabase-config.config.ts",
    "test:be02b:readiness": "node scripts/pdl-be02b-readiness.mjs",
    "accept:be02b": "npm run accept:be02 && npm run test:be02b:config && npm run test:be02b:readiness",
    "test:02c:managed-qr": "playwright test --config playwright.pdl-supabase-qr.config.ts",
    "accept:02c": "npm run accept:be02b && npm run test:02c:managed-qr",
    "test:02d:qr-object": "node --test supabase/tests/pdl_be02_edge_retry.test.mjs",
    "accept:02d": "npm run accept:02c && npm run test:02d:qr-object",
    "test:02e:sessions": "node --test scripts/tests/pdl-02e-signed-preflight.test.mjs",
    "test:qr-three": "playwright test --config playwright.pdl-qr-three.config.ts",
    "preflight:02e:signed": "node scripts/pdl-02e-signed-preflight.mjs",
    "accept:02e": "npm run accept:02d && npm run test:02e:sessions",
    "test:02f:r4:release": "node --test scripts/tests/pdl-02f-release-gate.test.mjs",
    "preflight:02f:r4": "node scripts/pdl-02f-release-gate.mjs",
    "accept:02f:r4": "npm run accept:02e && npm run test:02f:r4:release",
    "accept:02g": "npm run accept:02f:r4",
    "accept:02h": "npm run accept:02g",
    "accept:02i": "VITE_RESERVATION_API_BASE_URL='' npm run accept:02h",
    "accept:guest-experience-02": "bash ../../../../scripts/pdl-cp02-local-acceptance.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.0",
    "motion": "14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
